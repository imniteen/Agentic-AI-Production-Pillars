OPENAI_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT="Customer Service Agent"

# Backend API URL
AGENT_API_URL=http://127.0.0.1:8001/chat

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_state
POSTGRES_USER=agent_app
POSTGRES_PASSWORD=secure_password
POSTGRES_MIN_POOL_SIZE=10
POSTGRES_MAX_POOL_SIZE=100

# Azure Speech Service Configuration
# Get these from Azure Portal: Create resource -> Speech -> Keys and Endpoint
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastus

# Default voice and language (used as fallback when auto-detect fails)
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_LANGUAGE=en-US

# Multi-lingual Support:
# The speech service automatically detects the language from user's voice input
# and responds in the same language using an appropriate neural voice.
#
# IMPORTANT: Azure Speech auto-detect supports MAX 4 LANGUAGES at a time.
# Configure your preferred 4 languages below (comma-separated):
AZURE_AUTO_DETECT_LANGUAGES=en-IN,hi-IN,ta-IN,mr-IN
#
# Available language codes for auto-detection:
# - English: en-US, en-IN, en-GB
# - Hindi: hi-IN
# - Tamil: ta-IN
# - Telugu: te-IN
# - Marathi: mr-IN
# - Gujarati: gu-IN
# - Kannada: kn-IN
# - Malayalam: ml-IN
# - Bengali: bn-IN
# - Punjabi: pa-IN
#
# Additional TTS voices available for: French, German, Spanish, Italian,
# Portuguese, Japanese, Korean, Chinese, Arabic, etc.